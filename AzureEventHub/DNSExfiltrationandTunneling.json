                        "query": "let base =\r\n    Process_DnsQuery\r\n    | where Host matches regex '[[Computer]]'\r\n    | where isnotempty(DnsRequest)\r\n    | where $__timeFilter(Timestamp)\r\n    | project\r\n        TimeStamp = Timestamp,\r\n        DnsRequest = DnsRequest,\r\n        ProcName = ProcName,\r\n        Host = Host,\r\n        DnsEventCount = DnsEventCount,\r\n        DnsRisk52Chars = DnsRisk52Chars,\r\n        DnsRisk27UniqueChars = DnsRisk27UniqueChars,\r\n        DnsRiskEmptyResponse = DnsRiskEmptyResponse,\r\n        DnsRiskTXTRecord = DnsRiskTXTRecord,\r\n        DnsRiskHighEntropy = DnsRiskHighEntropy;\r\n\r\nlet pivoted =\r\n    base\r\n    | summarize\r\n        sumDnsEventCount = sum(DnsEventCount),\r\n        DnsRisk52Chars = sum(DnsRisk52Chars),\r\n        DnsRisk27UniqueChars = sum(DnsRisk27UniqueChars),\r\n        DnsRiskEmptyResponse = sum(DnsRiskEmptyResponse),\r\n        DnsRiskTXTRecord = sum(DnsRiskTXTRecord),\r\n        DnsRiskHighEntropy = sum(DnsRiskHighEntropy)\r\n      by DnsRequest, ProcName, Host, TimeStamp;\r\n\r\npivoted\r\n| extend Risk =\r\n      (DnsRisk52Chars * sumDnsEventCount)\r\n    + (DnsRisk27UniqueChars * sumDnsEventCount)\r\n    + (DnsRiskEmptyResponse * sumDnsEventCount)\r\n    + (DnsRiskTXTRecord * sumDnsEventCount)\r\n    + (DnsRiskHighEntropy * sumDnsEventCount)\r\n| extend ProcName = tostring(ProcName)\r\n| summarize Risk = sum(Risk)\r\n      by bin(TimeStamp, 10m), ProcName\r\n| where Risk > 0\r\n| order by TimeStamp asc\r\n",
